# Shopify App Credentials
# Obtain these from your app's page in the Shopify Partners dashboard.
SHOPIFY_API_KEY=your_shopify_api_key_here
SHOPIFY_API_SECRET=your_shopify_api_secret_here

# The public URL where this app is hosted (no trailing slash).
# Update this after deployment and re-run `shopify app deploy`.
SHOPIFY_APP_URL=https://your-app-url.example.com

# Comma-separated list of Shopify API scopes required by the app.
SCOPES=read_products

# Database connection string.
# SQLite (development):  file:./prisma/dev.db
# PostgreSQL (Railway):  postgresql://user:password@host:5432/dbname
DATABASE_URL=file:./prisma/dev.db

# Optional: restrict session cookies to a custom shop domain.
# SHOP_CUSTOM_DOMAIN=your-custom-domain.example.com
