// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Settings {
  id                String   @id @default(cuid())
  shop              String   @unique
  notificationEmail String?
  smtpHost          String?
  smtpPort          Int?
  smtpUser          String?
  smtpPassword      String?
  gtagCode          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Enquiry {
  id            String   @id @default(cuid())
  shop          String
  productHandle String?
  productTitle  String?
  quantity      Int?
  name          String
  email         String
  phone         String?
  comments      String?
  status        String   @default("new")
  createdAt     DateTime @default(now())
}
